NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API > service_role - server-only, never expose to the client.
# Required for inviting/deleting user accounts (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The site's public origin, no trailing path (https; http only for localhost).
# Invite links are built from this, never from request headers. Must match the
# Site URL in Supabase > Authentication > URL Configuration. Server-only.
SITE_URL=https://example.org
