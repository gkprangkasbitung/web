NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API > service_role - server-only, never expose to the client.
# Required for inviting/deleting user accounts (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The site's public origin, no trailing path (https; http only for localhost).
# Invite links are built from this, never from request headers. Must match the
# Site URL in Supabase > Authentication > URL Configuration. Server-only.
SITE_URL=
# Domain of the internal auth email of Portal Jemaat username accounts:
# {username}@{PORTAL_LOGIN_DOMAIN} (brief §18.7). A subdomain the church
# controls, with no mailbox, e.g. masuk.gkprangkasbitung.org. Never shown to
# jemaat. Server-only; the server refuses to start without a valid value.
PORTAL_LOGIN_DOMAIN=https://example.org
